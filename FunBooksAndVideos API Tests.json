    {
      "name": "02 - Retrieve purchase orders",
      "item": [
        {
          "name": "Get the order created earlier in this run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the previously created order details', () => {",
                  "  pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('createdOrderId')));",
                  "  pm.expect(body.customerId).to.eql(4567890);",
                  "  pm.expect(body.itemLines).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(body.itemLines[0].productName).to.eql('Comprehensive First Aid Training');",
                  "  pm.expect(body.itemLines[0].quantity).to.eql(1);",
                  "  pm.expect(body.itemLines[0].unitPrice).to.eql(33.51);",
                  "  pm.expect(body.totalPrice).to.eql(33.51);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/purchaseorder/{{createdOrderId}}"
          }
        },
        {
          "name": "Get a non-existent order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/purchaseorder/9999999"
          }
        }
      ]
    },
