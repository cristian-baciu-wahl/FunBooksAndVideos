{
  "info": {
    "_postman_id": "b48d8149-55a8-438d-9eb7-52d73f00145a",
    "name": "FunBooksAndVideos API Tests",
    "description": "Runnable API-contract tests. Business-rule side effects are covered by the .NET unit tests; this collection verifies observable HTTP behaviour.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const previousId = Number(pm.collectionVariables.get('nextOrderId'));",
          "const baseId = Number.isInteger(previousId) && previousId > 0",
          "  ? previousId",
          "  : Math.floor(Math.random() * 1900000000) + 100000000;",
          "const nextId = baseId + 1;",
          "pm.collectionVariables.set('nextOrderId', nextId);",
          "pm.variables.set('orderId', nextId);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Create valid purchase orders",
      "item": [
        {
          "name": "Create Book Club membership order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the created membership order summary', () => {",
                  "  pm.expect(body.orderId).to.eql(Number(pm.variables.get('orderId')));",
                  "  pm.expect(body.message).to.eql('Purchase order processed successfully');",
                  "  pm.expect(body.items).to.eql(1);",
                  "  pm.expect(body.totalPrice).to.eql(0);",
                  "});",
                  "pm.test('Returns a Location header for the order', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.include(String(body.orderId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{orderId}},\n  \"customerId\": 4567890,\n  \"items\": [\n    { \"membershipType\": \"BookClub\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/purchaseorder"
          }
        },
        {
          "name": "Create physical-book order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Uses the catalogue price and quantity', () => {",
                  "  pm.expect(body.orderId).to.eql(Number(pm.variables.get('orderId')));",
                  "  pm.expect(body.items).to.eql(1);",
                  "  pm.expect(body.totalPrice).to.eql(29.98);",
                  "});",
                  "pm.test('Returns a Location header', () => pm.expect(pm.response.headers.get('Location')).to.include(String(body.orderId)));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{orderId}},\n  \"customerId\": 4567890,\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/purchaseorder"
          }
        },
        {
          "name": "Create digital-video order and save ID for retrieval",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the expected server-calculated total', () => {",
                  "  pm.expect(body.orderId).to.eql(Number(pm.variables.get('orderId')));",
                  "  pm.expect(body.items).to.eql(1);",
                  "  pm.expect(body.totalPrice).to.eql(33.51);",
                  "});",
                  "pm.collectionVariables.set('createdOrderId', body.orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{orderId}},\n  \"customerId\": 4567890,\n  \"items\": [\n    { \"productId\": 2, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/purchaseorder"
          }
        },
        {
          "name": "Create mixed Premium and physical-book order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 201 Created', () => pm.response.to.have.status(201));",
