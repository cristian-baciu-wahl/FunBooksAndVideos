                  "pm.test('Returns the expected order summary', () => {",
                  "  pm.expect(body.orderId).to.eql(Number(pm.variables.get('orderId')));",
                  "  pm.expect(body.items).to.eql(2);",
                  "  pm.expect(body.totalPrice).to.eql(14.99);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{orderId}},\n  \"customerId\": 4567890,\n  \"items\": [\n    { \"membershipType\": \"Premium\", \"quantity\": 1 },\n    { \"productId\": 1, \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/purchaseorder"
          }
        }
